[Unit]
Description=DSH Gemini web subscription bridge and login browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=shortstories
WorkingDirectory=/home/shortstories/workspace/dsh
Environment=HOME=/home/shortstories
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/bin/bash /home/shortstories/workspace/dsh/gemini-web-start.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
